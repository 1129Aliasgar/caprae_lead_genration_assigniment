# Dependencies
node_modules/

# Build output
#
# `npm run build` writes here via tsc's `outDir`, and never alongside the
# sources — but running `npx tsc <file>` by hand ignores tsconfig and emits
# `.js` next to each `.ts`, which is how 49 stale files once ended up in `src/`.
# Ignoring them means that mistake cannot reach a commit even if it happens
# again.
dist/
*.tsbuildinfo

# Next.js
frontend/.next/
frontend/out/
frontend/.vercel/

# Environment — never commit. Contains the OpenRouter key this project used
# before extraction became deterministic, and the JWT secret.
.env
.env.local
.env.*.local
!.env.example
!.example.env

# Logs
*.log
npm-debug.log*
yarn-error.log*

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Coverage output, if tests are ever added
coverage/