{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "rootDir": "./backend/src",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
  },
  "include": ["src/**/*.ts"],
}
