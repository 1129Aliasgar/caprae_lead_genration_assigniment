PORT=5000
MONGO_URI=mongodb://localhost:27017/<DB_NAME>
JWT_SECRET=Your_Secret
JWT_EXPIRES_IN=1d
# Comma-separated allowlist of browser origins, or `*` for loopback-only dev.
#
# Do NOT rely on `*` meaning "any origin" — the API sets an httpOnly cookie, and
# browsers reject `Access-Control-Allow-Origin: *` on a credentialed request. The
# server reflects the requesting origin instead, and `*` restricts that to
# localhost/127.0.0.1 on any port. Set an explicit list in production:
#   CORS_ORIGIN=https://app.example.com,https://admin.example.com
CORS_ORIGIN=*
NODE_ENV=development

# ---- Logging ----
# debug | info | warn | error — anything below this is dropped
LOG_LEVEL=info


# ---- Seeding (npm run seed) ----
# Public Hugging Face Datasets Server. No auth required.
HF_DATASET_URL=https://datasets-server.huggingface.co/rows
HF_DATASET_NAME=xanderios/linkedin-job-postings
# Pause between pages. The server throttles by request volume, so paging
# back-to-back trips it within the first few thousand rows and the run gives up.
# 900ms is ~110 requests/minute — a full 33k seed takes ~5 minutes.
SEED_REQUEST_INTERVAL_MS=900

# ---- Recommendations ----
# Default number of leads returned when the request omits topN.
RECOMMENDATION_DEFAULT_TOP_N=20
# Reserved for a response cache that does not exist yet. Recorded ahead of the
# feature so introducing it is not a config-breaking change.
RECOMMENDATION_CACHE_TTL_SECONDS=600

# ---- Rate limiting ----
# 1 minute sliding window. Keyed by user id when authenticated, IP otherwise.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# Tighter budget for the ranking endpoints, which run a full aggregation each.
RATE_LIMIT_RECOMMENDATIONS_MAX=30